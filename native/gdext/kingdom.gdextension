; 빌드한 뒤 프로젝트의 bin/ 폴더로 복사한다(README). native/ 폴더는 Godot이 읽지 않는다(.gdignore).
[configuration]
entry_symbol = "kingdom_library_init"
compatibility_minimum = "4.4"

[libraries]
linux.debug.x86_64 = "res://bin/libkingdom.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libkingdom.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libkingdom.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libkingdom.windows.template_release.x86_64.dll"
macos.debug = "res://bin/libkingdom.macos.template_debug.framework"
macos.release = "res://bin/libkingdom.macos.template_release.framework"
