#!/usr/bin/env python
# godot-cpp(native/godot-cpp, 4.4.1-stable)가 있어야 한다. README 참고.
env = SConscript("../godot-cpp/SConstruct")
env.Append(CPPPATH=["src/", "../core/"])
sources = Glob("src/*.cpp") + ["../core/sim_core.cpp"]
library = env.SharedLibrary(
    "../../bin/libkingdom{}{}".format(env["suffix"], env["SHLIBSUFFIX"]), source=sources)
Default(library)
